# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tous Voisins
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API Adresse (BAN)
NEXT_PUBLIC_BAN_API_URL=https://api-adresse.data.gouv.fr

# Carte OpenStreetMap (tuiles)
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Cron
CRON_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@tous-voisins.fr

# Cloudinary (upload photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_ENV=dev

# ClamAV microservice (scan before Cloudinary upload)
CLAMAV_SERVICE_URL=
CLAMAV_SERVICE_ENABLED=true
CLAMAV_SERVICE_TIMEOUT=30000
CLAMAV_FAIL_MODE=fail_closed
CLAMAV_API_KEY=

# SMTP (transactional emails — local Inbucket: SMTP_HOST=127.0.0.1, SMTP_PORT=54325)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REJECT_UNAUTHORIZED=

# Admin notifications (account cancellation alerts)
ADMIN_NOTIFICATION_EMAIL=

# Prod — Dashboard Supabase → Auth → SMTP : smtp.resend.com, user resend, pass = RESEND_API_KEY
# Prod — Dashboard Supabase → Auth → URL Configuration :
#   site_url = NEXT_PUBLIC_APP_URL
#   redirect URLs (both required for password reset PKCE flow) :
#     {NEXT_PUBLIC_APP_URL}/auth/callback
#     {NEXT_PUBLIC_APP_URL}/auth/callback?type=recovery
RESEND_API_KEY=
EMAIL_FROM=contact@tous-voisins.fr
